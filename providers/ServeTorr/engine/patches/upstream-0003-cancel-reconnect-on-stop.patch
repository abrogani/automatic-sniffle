+func (bt *BTServer) current(epoch uint64) bool {
+	return !bt.stopped && bt.epoch == epoch
+}
+
+func (bt *BTServer) ConnectEpoch(epoch uint64) error {
+	bt.mu.RLock()
+	ok := bt.current(epoch)
+	bt.mu.RUnlock()
